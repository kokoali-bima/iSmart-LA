# Secrets and runtime state -- never commit these
.env
venv/
sessions.json
sessions.json.bak*
allowed_groups.json
MEMORY.md
lite-agent.log

# Generated from templates at install time -- contains YOUR real infra details
# (node IPs, hard boundaries). Never commit a filled-in copy of these.
/SOUL.md
/GEMINI.md

# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store
Thumbs.db

# Runtime state. None of this belongs in the repository -- and pin.json in
# particular holds the PIN's salt and hash, which a stray `git add -A` on a
# clone-based deployment would otherwise commit.
pin.json
servers.json
schedules.json
snapshots.json
setup_state.json
model_overrides.json
chat_language.json
gdrive_room_accounts.json
gdrive_oauth_client.json
.lite-agent.service.bak
/incoming/
/bin/
update_state.json
update_announce.json
spend.jsonl
/memory/
OWNER_SCOPE.md
*.log
tools/registry.json
