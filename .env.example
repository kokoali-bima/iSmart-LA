# Copy this file to .env and fill in the values. install.sh does this for you
# interactively -- this file exists mainly as documentation of every setting.
# chmod 600 .env once filled in (it holds real secrets).

# --- Telegram --------------------------------------------------------------
# Bot token from @BotFather (create a bot with /newbot).
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot directly
# (in DM, or in a group NOT registered via /registergroup). Get your own ID
# by messaging the bot /chatid once it's running, or via @userinfobot.
# WARNING: leaving this empty makes the bot respond to ANYONE.
ALLOWED_USER_IDS=

# Comma-separated numeric chat IDs (negative numbers) of Telegram groups
# where EVERY member is authorized, no per-person whitelist. Usually left
# empty at install time -- populate it live later via /registergroup (run by
# someone in ALLOWED_USER_IDS, inside the group). See README "Group access".
ALLOWED_GROUP_IDS=

# --- 9Router / Claude Code ---------------------------------------------------
# Base URL of your 9Router instance's native Anthropic-compatible endpoint.
ANTHROPIC_BASE_URL=http://127.0.0.1:20128
# API key configured in 9Router for this endpoint.
ANTHROPIC_API_KEY=
# Explicit model IDs as 9Router resolves them (NOT a combo alias -- see
# README "Why explicit models, not a combo"). The "cc/" prefix is 9Router's
# tag for its Claude Code OAuth provider connection; keep it unless your
# 9Router setup uses a different provider alias.
CLAUDE_MODEL_PRIMARY=cc/claude-haiku-4-5-20251001
CLAUDE_MODEL_FALLBACK=cc/claude-sonnet-5

# --- agy (Antigravity CLI) --------------------------------------------------
# Leave as default unless you installed agy somewhere non-standard.
AGY_BIN=/home/YOUR_USER/.local/bin/agy
AGY_MODEL_PRIMARY=gemini-3.7-flash-medium
AGY_MODEL_FALLBACK=gemini-3.1-pro-low

# --- Tuning (optional, defaults are usually fine) ---------------------------
# ALLOWED_TOOLS=Bash,WebSearch,WebFetch
# CLAUDE_TIMEOUT_SECONDS=600
# AGY_TIMEOUT_SECONDS=300
# AGY_PRINT_TIMEOUT=280s
